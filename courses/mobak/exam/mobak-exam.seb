<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Настройки Safe Exam Browser для контрольных МОБАК (lms/exam/README.md). Открыт только сайт курса и то, что ему нужно:
     Supabase (вход и сдачи), CodeMirror (редактор), Pyodide (Python в браузере). Остальные сайты и программы закрыты. -->
<plist version="1.0">
<dict>
  <key>originatorVersion</key>
  <string>SEB_Win_3.6</string>
  <key>startURL</key>
  <string>https://kstu-mobak.github.io/mobak-lms/courses/mobak/#me</string>
  <key>sebConfigPurpose</key>
  <integer>0</integer>
  <key>sendBrowserExamKey</key>
  <true/>
  <key>allowQuit</key>
  <true/>
  <key>hashedQuitPassword</key>
  <string></string>
  <key>quitURLConfirm</key>
  <true/>
  <key>browserWindowAllowReload</key>
  <true/>
  <key>showReloadButton</key>
  <true/>
  <key>showReloadWarning</key>
  <true/>
  <key>enableBrowserWindowToolbar</key>
  <true/>
  <key>browserWindowShowURL</key>
  <integer>0</integer>
  <key>enableZoomPage</key>
  <true/>
  <key>enableZoomText</key>
  <true/>
  <key>allowSpellCheck</key>
  <false/>
  <key>allowDictionaryLookup</key>
  <false/>
  <key>allowDownUploads</key>
  <false/>
  <key>allowPDFReader</key>
  <false/>
  <key>newBrowserWindowByLinkPolicy</key>
  <integer>1</integer>
  <key>newBrowserWindowByScriptPolicy</key>
  <integer>1</integer>
  <key>enablePrintScreen</key>
  <false/>
  <key>enableRightMouse</key>
  <true/>
  <key>allowVirtualMachine</key>
  <false/>
  <key>allowScreenSharing</key>
  <false/>
  <key>examSessionClearCookiesOnStart</key>
  <false/>
  <key>examSessionClearCookiesOnEnd</key>
  <false/>
  <key>URLFilterEnable</key>
  <true/>
  <key>URLFilterEnableContentFilter</key>
  <true/>
  <key>URLFilterRules</key>
  <array>
    <dict>
      <key>active</key><true/>
      <key>regex</key><false/>
      <key>expression</key><string>kstu-mobak.github.io/mobak-lms/*</string>
      <key>action</key><integer>1</integer>
    </dict>
    <dict>
      <key>active</key><true/>
      <key>regex</key><false/>
      <key>expression</key><string>tdyxkkylfhqpvdlbpwzs.supabase.co/*</string>
      <key>action</key><integer>1</integer>
    </dict>
    <dict>
      <key>active</key><true/>
      <key>regex</key><false/>
      <key>expression</key><string>cdn.jsdelivr.net/npm/@supabase/*</string>
      <key>action</key><integer>1</integer>
    </dict>
    <dict>
      <key>active</key><true/>
      <key>regex</key><false/>
      <key>expression</key><string>cdn.jsdelivr.net/pyodide/*</string>
      <key>action</key><integer>1</integer>
    </dict>
    <dict>
      <key>active</key><true/>
      <key>regex</key><false/>
      <key>expression</key><string>cdnjs.cloudflare.com/ajax/libs/codemirror/*</string>
      <key>action</key><integer>1</integer>
    </dict>
    <dict>
      <key>active</key><true/>
      <key>regex</key><false/>
      <key>expression</key><string>challenges.cloudflare.com/*</string>
      <key>action</key><integer>1</integer>
    </dict>
  </array>
</dict>
</plist>
